.tools{display:flex;gap:10px;align-items:center;flex:1;justify-content:flex-end;min-width:min(100%,280px)}
.search{position:relative;display:flex;align-items:center;flex:1;max-width:340px;min-width:0}
.search svg{position:absolute;left:14px;width:18px;height:18px;color:var(--mut);pointer-events:none}
.search input{width:100%;padding:11px 36px 11px 40px;border-radius:99px;border:1.5px solid var(--line);background:#fff;font:inherit;font-size:.95rem;color:var(--ink);outline:0;transition:border-color .3s}
.search input:focus{border-color:var(--brass)}
.search .clr{position:absolute;right:6px;width:28px;height:28px;border:0;border-radius:50%;background:transparent;font-size:1.3rem;line-height:1;color:var(--mut)}
#sort{padding:11px 14px;border-radius:99px;border:1.5px solid var(--line);background:#fff;font:inherit;font-size:.9rem;color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:20px}
.pcard{position:relative;display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;cursor:pointer;transition:transform .4s var(--ease),box-shadow .4s,border-color .3s}
.pcard:hover,.pcard:focus-visible{transform:translateY(-5px);box-shadow:0 24px 44px rgba(0,0,0,.12);border-color:var(--brass)}
.pimg{position:relative;aspect-ratio:1/1;background:#e9e3d3;overflow:hidden}
.pimg img{width:100%;height:100%;object-fit:cover;transition:transform .7s var(--ease)}
.pimg img.bad{opacity:0}
.pcard:hover .pimg img{transform:scale(1.07)}
.pbadge{position:absolute;top:10px;left:10px;z-index:2;background:var(--brass);color:#1a1303;font-size:.68rem;font-weight:800;padding:5px 11px;border-radius:99px;text-transform:uppercase;letter-spacing:.08em}
.pin{position:absolute;bottom:10px;left:10px;z-index:2;background:rgba(7,17,12,.88);color:var(--brass2);font-size:.72rem;font-weight:700;padding:4px 10px;border-radius:99px}
.pbody{display:flex;flex-direction:column;gap:6px;padding:14px 14px 14px;flex:1}
.pname{font-family:var(--sans);font-size:1rem;font-weight:800;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pdesc{font-size:.84rem;color:var(--mut);line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;flex:1}
.pfoot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px}
.pprice{font-family:var(--serif);font-weight:700;font-size:1.45rem;line-height:1;font-variant-numeric:lining-nums}
.pprice.q{font-family:var(--sans);font-size:.85rem;color:var(--mut);font-weight:700}
.padd{flex:none;width:42px;height:42px;border-radius:50%;border:0;background:linear-gradient(135deg,var(--brass2),var(--brass));color:#1a1303;display:grid;place-items:center;transition:transform .3s var(--ease),box-shadow .3s}
.padd:hover{transform:scale(1.12) rotate(90deg);box-shadow:0 8px 20px rgba(200,164,90,.5)}
.empty{text-align:center;color:var(--mut);padding:50px 0}
.noimg{display:block;width:100%;height:100%;background:linear-gradient(135deg,#d9d2bd,#efe9d8)}

/* overlays */
.scrim{position:fixed;inset:0;z-index:120;background:rgba(3,8,5,.62);opacity:0;transition:opacity .3s}
.scrim.on{opacity:1}
.modal{position:fixed;inset:0;z-index:130;display:grid;place-items:center;padding:20px;pointer-events:none;overflow-y:auto}
.modal[hidden],.drawer[hidden],.scrim[hidden]{display:none}
.sheet{position:relative;pointer-events:auto;width:min(980px,100%);max-height:calc(100dvh - 40px);overflow-y:auto;background:var(--paper);color:var(--ink);border-radius:24px;padding:28px;box-shadow:0 40px 90px rgba(0,0,0,.4);transform:translateY(24px) scale(.97);opacity:0;transition:transform .35s var(--ease),opacity .3s}
.modal.on .sheet{transform:none;opacity:1}
.sheet .x,.drawer .x{position:absolute;top:12px;right:14px;z-index:3;width:38px;height:38px;border-radius:50%;border:0;background:rgba(7,17,12,.07);font-size:1.6rem;line-height:1;color:var(--ink);transition:.25s}
.sheet .x:hover,.drawer .x:hover{background:var(--brass)}
.pm{display:grid;grid-template-columns:1.05fr 1fr;gap:34px;align-items:start}
.pm-main{position:relative;aspect-ratio:1/1;border-radius:18px;overflow:hidden;background:#e9e3d3}
.pm-main img{width:100%;height:100%;object-fit:cover}
.pm-thumbs{display:flex;gap:8px;margin-top:10px;overflow-x:auto}
.pm-thumbs button{flex:none;width:64px;height:64px;border-radius:12px;overflow:hidden;border:2px solid transparent;padding:0;background:#e9e3d3;opacity:.7;transition:.25s}
.pm-thumbs button.on{border-color:var(--brass);opacity:1}
.pm-thumbs img{width:100%;height:100%;object-fit:cover}
.illu{font-size:.76rem;color:var(--mut);margin-top:8px}
.pm-info h2{font-size:clamp(1.8rem,3.4vw,2.5rem);margin:4px 0 10px;padding-right:40px}
.pm-cat{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:#8a6a22;font-weight:800}
.pm-price{font-family:var(--serif);font-weight:700;font-size:2.2rem;line-height:1.1;margin-bottom:14px;font-variant-numeric:lining-nums}
.pm-price small{font-family:var(--sans);font-size:.9rem;color:var(--mut);font-weight:600}
.pm-price.q{font-family:var(--sans);font-size:1.1rem;color:var(--mut)}
.pm-var{display:grid;gap:8px;margin-bottom:14px}
.pm-var button{display:flex;justify-content:space-between;gap:12px;align-items:center;text-align:left;padding:12px 16px;border-radius:14px;border:1.5px solid var(--line);background:#fff;color:var(--ink);transition:.25s}
.pm-var button b{font-size:.92rem}
.pm-var button span{font-family:var(--serif);font-weight:700;font-size:1.2rem;white-space:nowrap}
.pm-var button.on{border-color:var(--brass);background:#fbf4e0;box-shadow:0 0 0 3px rgba(200,164,90,.2)}
.pm-buy{display:flex;gap:12px;align-items:center;margin-bottom:12px}
.pm-buy .btn{flex:1}
.step{display:inline-flex;align-items:center;border:1.5px solid var(--line);border-radius:99px;background:#fff}
.step button{width:40px;height:44px;border:0;background:transparent;font-size:1.3rem;color:var(--ink)}
.step output{min-width:30px;text-align:center;font-weight:800}
.step.sm button{width:32px;height:34px;font-size:1.1rem}
.hint{font-size:.84rem;color:var(--mut);margin:6px 0}
.pm-info h4,.prof h4{font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--mut);margin:22px 0 8px;font-weight:800}
.pm-text{color:#3a463f;line-height:1.7}
.specs{display:grid;gap:0}
.specs div{display:flex;justify-content:space-between;gap:16px;padding:9px 0;border-bottom:1px dashed var(--line);font-size:.92rem}
.specs dt{color:var(--mut)}
.specs dd{font-weight:700;text-align:right}

.drawer{position:fixed;top:0;right:0;bottom:0;z-index:130;width:min(460px,100%);display:flex;flex-direction:column;background:var(--paper);color:var(--ink);box-shadow:-30px 0 80px rgba(0,0,0,.35);transform:translateX(105%);transition:transform .4s var(--ease)}
.drawer.on{transform:none}
.drawer header{display:flex;align-items:center;justify-content:space-between;padding:20px 22px;border-bottom:1px solid var(--line)}
.drawer header h3{font-size:1.7rem}
.drawer header small{font-family:var(--sans);font-size:.9rem;color:var(--mut)}
.drawer .x{position:static}
.drawer-body{flex:1;overflow-y:auto;padding:8px 22px 22px;display:flex;flex-direction:column}
.cl{list-style:none}
.cl li{display:grid;grid-template-columns:64px 1fr auto;gap:12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}
.cl-img{width:64px;height:64px;border-radius:12px;overflow:hidden;background:#e9e3d3}
.cl-img img{width:100%;height:100%;object-fit:cover}
.cl-t{display:grid;gap:2px;min-width:0}
.cl-t b{font-size:.92rem;line-height:1.3}
.cl-t small{color:var(--mut)}
.cl-t span{font-family:var(--serif);font-weight:700;font-size:1.2rem}
.cl-t span.q{font-family:var(--sans);font-size:.78rem;color:var(--mut)}
.cl-c{display:grid;gap:6px;justify-items:end}
.rm{width:32px;height:32px;border:0;background:transparent;color:var(--mut);display:grid;place-items:center}
.rm:hover{color:#b33}
.rm svg{width:18px;height:18px}
.cart-foot{position:sticky;bottom:0;margin-top:auto;padding-top:16px;background:var(--paper)}
.cart-sum{display:flex;justify-content:space-between;align-items:baseline;font-weight:700;margin:12px 0}
.cart-sum b{font-family:var(--serif);font-size:1.9rem;font-variant-numeric:lining-nums}
.empty-cart{margin:auto;text-align:center;display:grid;gap:14px;justify-items:center;color:var(--mut)}
.empty-cart svg{width:64px;height:64px;fill:none;stroke:var(--brass);stroke-width:1.4}
.co{display:grid;gap:12px;padding-top:12px}
.co label,.auth label{display:grid;gap:5px;font-size:.78rem;font-weight:800;color:var(--mut)}
.co input,.co textarea,.auth input{padding:13px 15px;border-radius:12px;border:1.5px solid var(--line);font:inherit;font-size:1rem;background:#fff;color:var(--ink);outline:0;transition:border-color .3s,box-shadow .3s;width:100%}
.co input:focus,.co textarea:focus,.auth input:focus{border-color:var(--brass);box-shadow:0 0 0 4px rgba(200,164,90,.2)}
.err{color:#a02020;background:#fbe3e3;padding:10px 14px;border-radius:10px;font-size:.88rem}
.err[hidden]{display:none}
.drawer-body .done{margin:auto;text-align:center;display:grid;gap:12px;justify-items:center;padding:20px 0}
.drawer-body .done .ok{width:76px;height:76px;border-radius:50%;background:#dcf3e4;display:grid;place-items:center}
.drawer-body .done .ok svg{width:38px;height:38px;fill:none;stroke:#0d5a2d;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.drawer-body .done h3{font-size:2rem}
.auth{width:min(440px,100%);text-align:center;display:grid;gap:12px;justify-items:center}
.auth form{display:grid;gap:12px;width:100%;text-align:left}
.auth h3{font-size:2rem}
.ball.sm{width:52px;height:52px;font-size:1.2rem}
.link{background:none;border:0;color:#8a6a22;font-weight:700;font-size:.9rem;text-decoration:underline;padding:6px}
.prof{max-height:calc(100dvh - 40px)}
.ol{list-style:none;width:100%;text-align:left}
.ol li{display:grid;grid-template-columns:1fr auto;gap:4px 10px;padding:12px 0;border-bottom:1px solid var(--line)}
.ol li small{display:block;color:var(--mut)}
.ol-i{grid-column:1/-1;font-size:.84rem;color:var(--mut)}
.ol-t{font-family:var(--serif);font-size:1.2rem}
.st{align-self:start;font-size:.72rem;font-weight:800;padding:4px 10px;border-radius:99px;background:#eee;color:#333}
.st-new{background:#fff0cc;color:#6f4f00}.st-confirmed{background:#dcebff;color:#0d3a7a}.st-shipped{background:#e6e0ff;color:#3b2a8a}.st-done{background:#d9f2e2;color:#0b5429}.st-cancelled{background:#fbdada;color:#85201f}

.toast{position:fixed;left:50%;bottom:calc(28px + env(safe-area-inset-bottom));z-index:160;transform:translate(-50%,30px);opacity:0;pointer-events:none;background:var(--ink);color:#fff;border:1px solid var(--brass);padding:12px 22px;border-radius:99px;font-weight:700;font-size:.9rem;box-shadow:0 14px 40px rgba(0,0,0,.4);transition:.35s var(--ease)}
.toast.on{opacity:1;transform:translate(-50%,0)}

/* mobile tab bar (like marketplace apps) */
.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:90;display:none;grid-template-columns:repeat(4,1fr);background:rgba(7,17,12,.96);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid rgba(200,164,90,.3);padding:6px max(8px,env(safe-area-inset-right)) calc(6px + env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-left))}
.tabbar a,.tabbar button{position:relative;display:grid;justify-items:center;gap:2px;padding:6px 4px;border:0;background:transparent;color:rgba(255,255,255,.6);font-size:.68rem;font-weight:700;transition:color .25s}
.tabbar svg{width:24px;height:24px}
.tabbar .on{color:var(--brass2)}
.tabbar .badge{top:0;right:calc(50% - 22px)}
.tabbar .signed svg{stroke:#3ecf7a}

@media(max-width:1100px){.tiles{grid-template-columns:repeat(2,1fr)}}
@media(max-width:1060px){
  .nav-r .icon-btn{display:none}
  .tabbar{display:grid}
  .dock{display:none}
  body{padding-bottom:calc(66px + env(safe-area-inset-bottom))}
  footer{padding-bottom:30px}
  .toast{bottom:calc(84px + env(safe-area-inset-bottom))}
}
@media(max-width:760px){
  .grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .pdesc{display:none}
  .pbody{padding:10px 10px 12px}
  .pname{font-size:.9rem}
  .pprice{font-size:1.2rem}
  .padd{width:38px;height:38px}
  .bigsearch{padding:6px 6px 6px 16px}
  .bigsearch .btn{padding:11px 16px}
  .tiles{gap:10px}
  .tile-t b{font-size:1.35rem}
  .shop-bar{top:74px;gap:8px;padding:10px 0}
  .tools{width:100%;max-width:none}
  .search{max-width:none}
  .catalog-view{padding-top:96px}
  .modal{place-items:end center;padding:0}
  .sheet{width:100%;max-height:92dvh;border-radius:24px 24px 0 0;padding:20px 18px calc(20px + env(safe-area-inset-bottom));transform:translateY(100%);opacity:1}
  .modal.on .sheet{transform:none}
  .pm{grid-template-columns:1fr;gap:16px}
  .drawer{width:100%;border-radius:0}
  .drawer header{padding-top:max(18px,env(safe-area-inset-top))}
  .auth{padding-top:26px}
}
@media(max-width:380px){.grid{gap:8px}.tile-t{padding:12px}.tile-t b{font-size:1.15rem}}
html.mini .marquee{display:none}
html.mini #menu,html.mini .nav-cta,html.mini .burger{display:none}
/* catalog page has no dark hero behind the header, so keep it solid */
body[data-view="catalog"] .nav{background:rgba(7,17,12,.96);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 6px 30px rgba(0,0,0,.25)}
/* why-us tiles (dark band) */
.why4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.dark .glow{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.14);color:#fff}
.dark .glow:hover{background:rgba(255,255,255,.08);border-color:var(--brass);box-shadow:0 26px 50px rgba(0,0,0,.4)}
.dark .glow p{color:rgba(255,255,255,.72)}
.dark .glow svg{background:rgba(200,164,90,.14)}
@media(max-width:1000px){.why4{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.why4{grid-template-columns:1fr;gap:12px}.glow{padding:24px 20px}}
