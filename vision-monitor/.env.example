# Barcha sozlamalar ixtiyoriy
VM_DATA=./data            # baza, rasmlar va modellar shu yerda saqlanadi
VM_SECRET=                # bo'sh bo'lsa data/secret.key avtomatik yaratiladi
VM_TOKEN_HOURS=24
VM_FPS=4                  # har bir kameradan sekundiga nechta kadr tahlil qilinadi
VM_YOLO_MODEL=yolov8n.pt  # aniqroq natija uchun yolov8s.pt yoki yolov8m.pt
VM_DEVICE=                # "cpu", "cuda:0" yoki bo'sh (avtomatik)
VM_FACE_MODEL=buffalo_l   # yoki buffalo_s (yengilroq, kamroq aniq)
VM_ID_THRESHOLD=0.45      # shaxsni tasdiqlash qat'iyligi (oshirsangiz — kamroq xato, ko'proq "Noma'lum")
VM_ID_MARGIN=0.08
