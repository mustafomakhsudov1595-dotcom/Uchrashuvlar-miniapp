{
  "name": "impro-notes",
  "main": "server/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "KV", "id": "cd4c34c23192483cb1fe0f39cf5896d6" }],
  "vars": { "BOT_USERNAME": "Improitnotes_bot", "SITE_URL": "https://impro-notes.uchrashuvlar-mini-app.workers.dev" }
}
